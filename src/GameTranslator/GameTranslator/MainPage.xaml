<Page x:Class="GameTranslator.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{ThemeResource AppBackgroundBrush}">
  <Page.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FCFBFF" />
          <SolidColorBrush x:Key="AppSurfaceBrush" Color="#F7F7F9" />
          <SolidColorBrush x:Key="AppBorderBrush" Color="#E4E1E6" />
          <SolidColorBrush x:Key="AppTextBrush" Color="#1C1B1F" />
          <SolidColorBrush x:Key="AppSecondaryTextBrush" Color="#625B71" />
          <SolidColorBrush x:Key="AppAccentBrush" Color="#C7BFFF" />
          <SolidColorBrush x:Key="ThemePreviewDarkBrush" Color="#1C1B1F" />
          <SolidColorBrush x:Key="ThemePreviewDarkTextBrush" Color="#E6E1E5" />
          <SolidColorBrush x:Key="ThemePreviewLightBrush" Color="#FCFBFF" />
          <SolidColorBrush x:Key="ThemePreviewLightTextBrush" Color="#1C1B1F" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="AppBackgroundBrush" Color="#1C1B1F" />
          <SolidColorBrush x:Key="AppSurfaceBrush" Color="#302D37" />
          <SolidColorBrush x:Key="AppBorderBrush" Color="#49454F" />
          <SolidColorBrush x:Key="AppTextBrush" Color="#E6E1E5" />
          <SolidColorBrush x:Key="AppSecondaryTextBrush" Color="#C9C5D0" />
          <SolidColorBrush x:Key="AppAccentBrush" Color="#C7BFFF" />
          <SolidColorBrush x:Key="ThemePreviewDarkBrush" Color="#1C1B1F" />
          <SolidColorBrush x:Key="ThemePreviewDarkTextBrush" Color="#E6E1E5" />
          <SolidColorBrush x:Key="ThemePreviewLightBrush" Color="#FCFBFF" />
          <SolidColorBrush x:Key="ThemePreviewLightTextBrush" Color="#1C1B1F" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <Style x:Key="SettingsListItemButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextBrush}" />
      </Style>
      <Style x:Key="SettingsGroupBorder" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource AppSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AppBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="28" />
      </Style>
      <Style x:Key="HeaderBackButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextBrush}" />
      </Style>
      <Style x:Key="ThemeModeOptionBorder" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource AppSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AppBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="4" />
      </Style>
      <Style x:Key="SelectedThemeModeOptionBorder" TargetType="Border" BasedOn="{StaticResource ThemeModeOptionBorder}">
        <Setter Property="BorderBrush" Value="{ThemeResource AppAccentBrush}" />
        <Setter Property="BorderThickness" Value="2" />
      </Style>
      <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource AppTextBrush}" />
      </Style>
      <Style TargetType="FontIcon">
        <Setter Property="Foreground" Value="{ThemeResource AppTextBrush}" />
      </Style>
    </ResourceDictionary>
  </Page.Resources>

  <Grid MaxWidth="720" Padding="20,20,20,16" RowSpacing="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid x:Name="HomeHeader" ColumnSpacing="16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="GameTranslator" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <TextBlock Text="Tłumacz" VerticalAlignment="Center" />
        <ToggleSwitch x:Name="SessionToggle" Toggled="SessionToggle_Toggled" />
      </StackPanel>
    </Grid>

    <Grid x:Name="DetailHeader" Visibility="Collapsed" ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Button Style="{StaticResource HeaderBackButton}" Click="Back_Click" Width="44" Height="44" Padding="0" ToolTipService.ToolTip="Wróć do ustawień">
        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE72B;" FontSize="18" />
      </Button>
      <TextBlock x:Name="DetailTitle" Grid.Column="1" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
    </Grid>

    <Grid Grid.Row="1">
      <ScrollViewer x:Name="HomeView" VerticalScrollBarVisibility="Hidden">
        <StackPanel Spacing="8">
          <TextBlock Text="Ustawienia" FontSize="15" FontWeight="SemiBold" Opacity="0.65" Margin="16,8,0,8" />

          <Border Style="{StaticResource SettingsGroupBorder}">
            <StackPanel>
          <Button Style="{StaticResource SettingsListItemButton}" Tag="permissions" Click="OpenSection_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16,14">
            <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE72E;" FontSize="20" VerticalAlignment="Center" /><StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="Uprawnienia" FontWeight="SemiBold" /><TextBlock Text="Nakładka i dostępność systemu Android" Opacity="0.65" TextWrapping="Wrap" /></StackPanel><FontIcon Grid.Column="2" FontFamily="Segoe MDL2 Assets" Glyph="&#xE76C;" FontSize="16" VerticalAlignment="Center" /></Grid>
          </Button>
          <Border Height="1" Margin="16,0" Background="{ThemeResource AppBorderBrush}" />
          <Button Style="{StaticResource SettingsListItemButton}" Tag="api" Click="OpenSection_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16,14">
            <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE72E;" FontSize="20" VerticalAlignment="Center" /><StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="Google Cloud API" FontWeight="SemiBold" /><TextBlock Text="Klucz do rozpoznawania i tłumaczenia tekstu" Opacity="0.65" TextWrapping="Wrap" /></StackPanel><FontIcon Grid.Column="2" FontFamily="Segoe MDL2 Assets" Glyph="&#xE76C;" FontSize="16" VerticalAlignment="Center" /></Grid>
          </Button>
          <Border Height="1" Margin="16,0" Background="{ThemeResource AppBorderBrush}" />
          <Button Style="{StaticResource SettingsListItemButton}" Tag="translation" Click="OpenSection_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16,14">
            <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE774;" FontSize="20" VerticalAlignment="Center" /><StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="Tłumaczenie" FontWeight="SemiBold" /><TextBlock Text="Języki źródłowy i docelowy" Opacity="0.65" TextWrapping="Wrap" /></StackPanel><FontIcon Grid.Column="2" FontFamily="Segoe MDL2 Assets" Glyph="&#xE76C;" FontSize="16" VerticalAlignment="Center" /></Grid>
          </Button>
          <Border Height="1" Margin="16,0" Background="{ThemeResource AppBorderBrush}" />
          <Button Style="{StaticResource SettingsListItemButton}" Tag="triggers" Click="OpenSection_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16,14">
            <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE765;" FontSize="20" VerticalAlignment="Center" /><StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="Globalny hotkey" FontWeight="SemiBold" /><TextBlock Text="Skrót do pokazywania tłumaczenia" Opacity="0.65" TextWrapping="Wrap" /></StackPanel><FontIcon Grid.Column="2" FontFamily="Segoe MDL2 Assets" Glyph="&#xE76C;" FontSize="16" VerticalAlignment="Center" /></Grid>
          </Button>
          <Border Height="1" Margin="16,0" Background="{ThemeResource AppBorderBrush}" />
          <Button Style="{StaticResource SettingsListItemButton}" Tag="recognition" Click="OpenSection_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16,14">
            <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8C8;" FontSize="20" VerticalAlignment="Center" /><StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="Rozpoznawanie tekstu" FontWeight="SemiBold" /><TextBlock Text="Próg pewności wyników OCR" Opacity="0.65" TextWrapping="Wrap" /></StackPanel><FontIcon Grid.Column="2" FontFamily="Segoe MDL2 Assets" Glyph="&#xE76C;" FontSize="16" VerticalAlignment="Center" /></Grid>
          </Button>
          <Border Height="1" Margin="16,0" Background="{ThemeResource AppBorderBrush}" />
          <Button Style="{StaticResource SettingsListItemButton}" Tag="appearance" Click="OpenSection_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16,14">
            <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8D2;" FontSize="20" VerticalAlignment="Center" /><StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="Wygląd nakładki" FontWeight="SemiBold" /><TextBlock Text="Skala tekstu i widoczność tłumaczeń" Opacity="0.65" TextWrapping="Wrap" /></StackPanel><FontIcon Grid.Column="2" FontFamily="Segoe MDL2 Assets" Glyph="&#xE76C;" FontSize="16" VerticalAlignment="Center" /></Grid>
          </Button>
          <Border Height="1" Margin="16,0" Background="{ThemeResource AppBorderBrush}" />
          <Button Style="{StaticResource SettingsListItemButton}" Tag="appTheme" Click="OpenSection_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16,14">
            <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE793;" FontSize="20" VerticalAlignment="Center" /><StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="Wygląd aplikacji" FontWeight="SemiBold" /><TextBlock x:Name="ThemeModeValue" Opacity="0.65" TextWrapping="Wrap" /></StackPanel><FontIcon Grid.Column="2" FontFamily="Segoe MDL2 Assets" Glyph="&#xE76C;" FontSize="16" VerticalAlignment="Center" /></Grid>
          </Button>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <ScrollViewer x:Name="DetailView" Visibility="Collapsed" VerticalScrollBarVisibility="Hidden">
        <Grid>
          <StackPanel x:Name="TranslationSection" Visibility="Collapsed" Spacing="8">
            <Border Style="{StaticResource SettingsGroupBorder}">
              <StackPanel>
            <Button Style="{StaticResource SettingsListItemButton}" Click="EditSourceLanguage_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16,14"><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE774;" FontSize="20" VerticalAlignment="Center" /><StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="Język źródłowy" FontWeight="SemiBold" /><TextBlock x:Name="SourceLanguageValue" Opacity="0.65" /></StackPanel><FontIcon Grid.Column="2" FontFamily="Segoe MDL2 Assets" Glyph="&#xE76C;" FontSize="16" VerticalAlignment="Center" /></Grid></Button>
            <Border Height="1" Margin="16,0" Background="{ThemeResource AppBorderBrush}" />
            <Button Style="{StaticResource SettingsListItemButton}" Click="EditTargetLanguage_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16,14"><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8D4;" FontSize="20" VerticalAlignment="Center" /><StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="Język docelowy" FontWeight="SemiBold" /><TextBlock x:Name="TargetLanguageValue" Opacity="0.65" /></StackPanel><FontIcon Grid.Column="2" FontFamily="Segoe MDL2 Assets" Glyph="&#xE76C;" FontSize="16" VerticalAlignment="Center" /></Grid></Button>
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel x:Name="ApiSection" Visibility="Collapsed" Spacing="8">
            <Border Style="{StaticResource SettingsGroupBorder}">
            <Button Style="{StaticResource SettingsListItemButton}" Click="EditApiKey_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16,14"><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE72E;" FontSize="20" VerticalAlignment="Center" /><StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="Google Cloud API key" FontWeight="SemiBold" /><TextBlock x:Name="ApiKeyValue" Opacity="0.65" TextWrapping="Wrap" /></StackPanel><FontIcon Grid.Column="2" FontFamily="Segoe MDL2 Assets" Glyph="&#xE76C;" FontSize="16" VerticalAlignment="Center" /></Grid></Button>
            </Border>
          </StackPanel>

          <StackPanel x:Name="AppearanceSection" Visibility="Collapsed" Spacing="8">
            <Border Style="{StaticResource SettingsGroupBorder}">
              <StackPanel>
            <Button Style="{StaticResource SettingsListItemButton}" Click="EditFontScale_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16,14"><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8D2;" FontSize="20" VerticalAlignment="Center" /><StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="Skalowanie czcionki" FontWeight="SemiBold" /><TextBlock x:Name="FontScaleValue" Opacity="0.65" /></StackPanel><FontIcon Grid.Column="2" FontFamily="Segoe MDL2 Assets" Glyph="&#xE76C;" FontSize="16" VerticalAlignment="Center" /></Grid></Button>
            <Border Height="1" Margin="16,0" Background="{ThemeResource AppBorderBrush}" />
            <Grid><Button Style="{StaticResource SettingsListItemButton}" IsHitTestVisible="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16,14"><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="52" /></Grid.ColumnDefinitions><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8A1;" FontSize="20" VerticalAlignment="Center" /><StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="Ukrywaj identyczne tłumaczenia" FontWeight="SemiBold" /><TextBlock Text="Nie pokazuj tekstu, gdy tłumaczenie jest takie samo." Opacity="0.65" TextWrapping="Wrap" /></StackPanel></Grid></Button><ToggleSwitch x:Name="HideIdenticalTranslationsToggle" HorizontalAlignment="Right" Margin="0,0,16,0" Toggled="Setting_Changed" VerticalAlignment="Center" /></Grid>
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel x:Name="RecognitionSection" Visibility="Collapsed" Spacing="8">
            <Border Style="{StaticResource SettingsGroupBorder}">
            <Button Style="{StaticResource SettingsListItemButton}" Click="EditRecognitionConfidence_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16,14"><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8C8;" FontSize="20" VerticalAlignment="Center" /><StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="Pewność rozpoznawania" FontWeight="SemiBold" /><TextBlock x:Name="RecognitionConfidenceValue" Opacity="0.65" /></StackPanel><FontIcon Grid.Column="2" FontFamily="Segoe MDL2 Assets" Glyph="&#xE76C;" FontSize="16" VerticalAlignment="Center" /></Grid></Button>
            </Border>
          </StackPanel>

          <StackPanel x:Name="TriggersSection" Visibility="Collapsed" Spacing="8">
            <Border Style="{StaticResource SettingsGroupBorder}">
              <StackPanel>
            <Grid><Button Style="{StaticResource SettingsListItemButton}" IsHitTestVisible="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16,14"><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="52" /></Grid.ColumnDefinitions><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE765;" FontSize="20" VerticalAlignment="Center" /><StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="Włącz globalny hotkey" FontWeight="SemiBold" /><TextBlock Text="Pozwala wywołać tłumaczenie poza aplikacją." Opacity="0.65" TextWrapping="Wrap" /></StackPanel></Grid></Button><ToggleSwitch x:Name="GlobalHotkeyToggle" HorizontalAlignment="Right" Margin="0,0,16,0" Toggled="Setting_Changed" VerticalAlignment="Center" /></Grid>
            <Border Height="1" Margin="16,0" Background="{ThemeResource AppBorderBrush}" />
            <Button Style="{StaticResource SettingsListItemButton}" Click="EditHotkeyCode_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16,14"><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE765;" FontSize="20" VerticalAlignment="Center" /><StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="Klawisz skrótu" FontWeight="SemiBold" /><TextBlock x:Name="HotkeyCodeValue" Opacity="0.65" /></StackPanel><FontIcon Grid.Column="2" FontFamily="Segoe MDL2 Assets" Glyph="&#xE76C;" FontSize="16" VerticalAlignment="Center" /></Grid></Button>
            <Border Height="1" Margin="16,0" Background="{ThemeResource AppBorderBrush}" />
            <Grid><Button Style="{StaticResource SettingsListItemButton}" IsHitTestVisible="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16,14"><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="52" /></Grid.ColumnDefinitions><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE768;" FontSize="20" VerticalAlignment="Center" /><StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="Pokazuj tylko podczas przytrzymania" FontWeight="SemiBold" /><TextBlock Text="Po zwolnieniu klawisza nakładka zostanie ukryta." Opacity="0.65" TextWrapping="Wrap" /></StackPanel></Grid></Button><ToggleSwitch x:Name="HoldToPreviewToggle" HorizontalAlignment="Right" Margin="0,0,16,0" Toggled="Setting_Changed" VerticalAlignment="Center" /></Grid>
            <Border Height="1" Margin="16,0" Background="{ThemeResource AppBorderBrush}" />
            <Button Style="{StaticResource SettingsListItemButton}" Click="OpenAccessibilitySettings_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16,14"><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE72E;" FontSize="20" VerticalAlignment="Center" /><StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="Ustawienia dostępności" FontWeight="SemiBold" /><TextBlock Text="Włącz usługę systemową dla globalnego hotkeya." Opacity="0.65" TextWrapping="Wrap" /></StackPanel><FontIcon Grid.Column="2" FontFamily="Segoe MDL2 Assets" Glyph="&#xE76C;" FontSize="16" VerticalAlignment="Center" /></Grid></Button>
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel x:Name="PermissionsSection" Visibility="Collapsed" Spacing="8">
            <Border Style="{StaticResource SettingsGroupBorder}">
            <Button Style="{StaticResource SettingsListItemButton}" Click="RequestOverlayPermission_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16,14"><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE72E;" FontSize="20" VerticalAlignment="Center" /><StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="Nakładka nad grą" FontWeight="SemiBold" /><TextBlock Text="Zezwól aplikacji wyświetlać tłumaczenie nad innymi aplikacjami." Opacity="0.65" TextWrapping="Wrap" /></StackPanel><FontIcon Grid.Column="2" FontFamily="Segoe MDL2 Assets" Glyph="&#xE76C;" FontSize="16" VerticalAlignment="Center" /></Grid></Button>
            </Border>
          </StackPanel>

          <StackPanel x:Name="ThemeSection" Visibility="Collapsed" Spacing="12">
            <TextBlock Text="Motyw" FontSize="16" FontWeight="SemiBold" />
            <Border Background="{ThemeResource AppSurfaceBrush}" BorderBrush="{ThemeResource AppBorderBrush}" BorderThickness="1" CornerRadius="28" Padding="16">
              <StackPanel Spacing="12">
                <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border x:Name="SystemThemeOption" Tag="System" Style="{StaticResource ThemeModeOptionBorder}" Tapped="ThemeModeOption_Tapped">
                  <Grid RowSpacing="6"><Grid.RowDefinitions><RowDefinition Height="52" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Border CornerRadius="8"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#1C1B1F" Offset="0" /><GradientStop Color="#1C1B1F" Offset="0.5" /><GradientStop Color="#FCFBFF" Offset="0.5" /><GradientStop Color="#FCFBFF" Offset="1" /></LinearGradientBrush></Border.Background></Border><TextBlock Grid.Row="1" Text="System" FontSize="12" HorizontalAlignment="Center" /></Grid>
                </Border>
                <Border x:Name="DarkThemeOption" Grid.Column="1" Tag="Dark" Style="{StaticResource ThemeModeOptionBorder}" Tapped="ThemeModeOption_Tapped">
                  <Grid RowSpacing="6"><Grid.RowDefinitions><RowDefinition Height="52" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Border Background="{ThemeResource ThemePreviewDarkBrush}" CornerRadius="8" Padding="8"><StackPanel Spacing="4" VerticalAlignment="Center"><Border Width="28" Height="4" Background="{ThemeResource ThemePreviewDarkTextBrush}" CornerRadius="2" /><Border Width="44" Height="3" Opacity="0.45" Background="{ThemeResource ThemePreviewDarkTextBrush}" CornerRadius="2" /><Border Width="34" Height="3" Opacity="0.45" Background="{ThemeResource ThemePreviewDarkTextBrush}" CornerRadius="2" /></StackPanel></Border><TextBlock Grid.Row="1" Text="Ciemny" FontSize="12" HorizontalAlignment="Center" /></Grid>
                </Border>
                <Border x:Name="LightThemeOption" Grid.Column="2" Tag="Light" Style="{StaticResource ThemeModeOptionBorder}" Tapped="ThemeModeOption_Tapped">
                  <Grid RowSpacing="6"><Grid.RowDefinitions><RowDefinition Height="52" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Border Background="{ThemeResource ThemePreviewLightBrush}" CornerRadius="8" Padding="8"><StackPanel Spacing="4" VerticalAlignment="Center"><Border Width="28" Height="4" Background="{ThemeResource ThemePreviewLightTextBrush}" CornerRadius="2" /><Border Width="44" Height="3" Opacity="0.45" Background="{ThemeResource ThemePreviewLightTextBrush}" CornerRadius="2" /><Border Width="34" Height="3" Opacity="0.45" Background="{ThemeResource ThemePreviewLightTextBrush}" CornerRadius="2" /></StackPanel></Border><TextBlock Grid.Row="1" Text="Jasny" FontSize="12" HorizontalAlignment="Center" /></Grid>
                </Border>
                </Grid>
                <Border Height="1" Background="{ThemeResource AppBorderBrush}" />
                <TextBlock Text="Akcent" FontSize="16" FontWeight="SemiBold" />
                <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" HorizontalContentAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <Border x:Name="LavenderAccentOption" Tag="Lavender" Width="48" Height="48" Padding="8" BorderBrush="#C7BFFF" CornerRadius="24" Tapped="AccentOption_Tapped"><Border Background="#C7BFFF" CornerRadius="16" /></Border>
                    <Border x:Name="CoralAccentOption" Tag="Coral" Width="48" Height="48" Padding="8" BorderBrush="#F08A6D" CornerRadius="24" Tapped="AccentOption_Tapped"><Border Background="#F08A6D" CornerRadius="16" /></Border>
                    <Border x:Name="AmberAccentOption" Tag="Amber" Width="48" Height="48" Padding="8" BorderBrush="#E4B24A" CornerRadius="24" Tapped="AccentOption_Tapped"><Border Background="#E4B24A" CornerRadius="16" /></Border>
                    <Border x:Name="LimeAccentOption" Tag="Lime" Width="48" Height="48" Padding="8" BorderBrush="#AACF5B" CornerRadius="24" Tapped="AccentOption_Tapped"><Border Background="#AACF5B" CornerRadius="16" /></Border>
                    <Border x:Name="MintAccentOption" Tag="Mint" Width="48" Height="48" Padding="8" BorderBrush="#67D39A" CornerRadius="24" Tapped="AccentOption_Tapped"><Border Background="#67D39A" CornerRadius="16" /></Border>
                    <Border x:Name="TealAccentOption" Tag="Teal" Width="48" Height="48" Padding="8" BorderBrush="#4DD0C2" CornerRadius="24" Tapped="AccentOption_Tapped"><Border Background="#4DD0C2" CornerRadius="16" /></Border>
                    <Border x:Name="AquaAccentOption" Tag="Aqua" Width="48" Height="48" Padding="8" BorderBrush="#00BCD4" CornerRadius="24" Tapped="AccentOption_Tapped"><Border Background="#00BCD4" CornerRadius="16" /></Border>
                    <Border x:Name="SkyAccentOption" Tag="Sky" Width="48" Height="48" Padding="8" BorderBrush="#6BB6E8" CornerRadius="24" Tapped="AccentOption_Tapped"><Border Background="#6BB6E8" CornerRadius="16" /></Border>
                    <Border x:Name="SteelAccentOption" Tag="Steel" Width="48" Height="48" Padding="8" BorderBrush="#8AA4B6" CornerRadius="24" Tapped="AccentOption_Tapped"><Border Background="#8AA4B6" CornerRadius="16" /></Border>
                    <Border x:Name="OrchidAccentOption" Tag="Orchid" Width="48" Height="48" Padding="8" BorderBrush="#D184D8" CornerRadius="24" Tapped="AccentOption_Tapped"><Border Background="#D184D8" CornerRadius="16" /></Border>
                    <Border x:Name="RoseAccentOption" Tag="Rose" Width="48" Height="48" Padding="8" BorderBrush="#EC7A9E" CornerRadius="24" Tapped="AccentOption_Tapped"><Border Background="#EC7A9E" CornerRadius="16" /></Border>
                  </StackPanel>
                </ScrollViewer>
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel Visibility="Collapsed">
            <ComboBox x:Name="SourceLanguageBox" SelectionChanged="Setting_Changed"><ComboBoxItem Tag="ja" Content="Japoński" /><ComboBoxItem Tag="en" Content="Angielski" /><ComboBoxItem Tag="ko" Content="Koreański" /><ComboBoxItem Tag="zh" Content="Chiński (uproszczony)" /><ComboBoxItem Tag="de" Content="Niemiecki" /></ComboBox>
            <ComboBox x:Name="TargetLanguageBox" SelectionChanged="Setting_Changed"><ComboBoxItem Tag="pl" Content="Polski" /><ComboBoxItem Tag="en" Content="Angielski" /><ComboBoxItem Tag="de" Content="Niemiecki" /><ComboBoxItem Tag="es" Content="Hiszpański" /></ComboBox>
            <PasswordBox x:Name="ApiKeyBox" PasswordChanged="Setting_Changed" />
            <Slider x:Name="FontScaleSlider" Minimum="1" Maximum="3" StepFrequency="0.1" Value="1" ValueChanged="FontScaleSlider_ValueChanged" />
            <Slider x:Name="RecognitionConfidenceSlider" Minimum="0" Maximum="1" StepFrequency="0.1" Value="0.6" ValueChanged="RecognitionConfidenceSlider_ValueChanged" />
            <TextBox x:Name="HotkeyCodeBox" TextChanged="Setting_Changed" />
          </StackPanel>
        </Grid>
      </ScrollViewer>
    </Grid>
  </Grid>
</Page>
