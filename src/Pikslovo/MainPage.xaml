                    <Button x:Name="OrchidAccentOption" Command="{Binding SelectAccentCommand}" CommandParameter="Orchid" Style="{StaticResource AccentOptionButton}" Width="48" Height="48" BorderBrush="#D184D8"><Border Background="#D184D8" CornerRadius="16" /></Button>
                    <Button x:Name="RoseAccentOption" Command="{Binding SelectAccentCommand}" CommandParameter="Rose" Style="{StaticResource AccentOptionButton}" Width="48" Height="48" BorderBrush="#EC7A9E"><Border Background="#EC7A9E" CornerRadius="16" /></Button>
                  </StackPanel>
                </ScrollViewer>
                <Border Height="1" Background="{ThemeResource AppBorderBrush}" />
                <TextBlock Text="AppLanguage" FontSize="16" FontWeight="SemiBold" />
