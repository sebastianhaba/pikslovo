                <Border Height="1" Margin="16,0" Background="{ThemeResource AppBorderBrush}" />
                <Grid Margin="16,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="CloudTranslationLabel" /><TextBlock Text="{Binding CloudTranslationDuration}" Grid.Column="1" FontWeight="SemiBold" /></Grid>
