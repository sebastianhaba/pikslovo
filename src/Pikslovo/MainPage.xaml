                    <Button x:Name="AmberAccentOption" Command="{Binding SelectAccentCommand}" CommandParameter="Amber" Style="{StaticResource AccentOptionButton}" Width="48" Height="48" BorderBrush="#E4B24A"><Border Background="#E4B24A" CornerRadius="16" /></Button>
                    <Button x:Name="LimeAccentOption" Command="{Binding SelectAccentCommand}" CommandParameter="Lime" Style="{StaticResource AccentOptionButton}" Width="48" Height="48" BorderBrush="#AACF5B"><Border Background="#AACF5B" CornerRadius="16" /></Button>
