                <Grid><Button Style="{StaticResource SettingsListItemButton}" IsHitTestVisible="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16,14"><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="52" /></Grid.ColumnDefinitions><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE890;" FontSize="20" VerticalAlignment="Center" /><StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="AlwaysShowButton" FontWeight="SemiBold" /><TextBlock Text="{Binding FloatingButtonVisibilityDescription}" Opacity="0.65" TextWrapping="Wrap" /></StackPanel></Grid></Button><ToggleSwitch HorizontalAlignment="Right" Margin="0,0,16,0" IsOn="{Binding FloatingButtonAlwaysVisible, Mode=TwoWay}" VerticalAlignment="Center" /></Grid>
