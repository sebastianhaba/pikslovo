            <Button Style="{StaticResource SettingsListItemButton}" Command="{Binding OpenAccessibilitySettingsCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16,14"><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE72E;" FontSize="20" VerticalAlignment="Center" /><StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="AccessibilitySettings" FontWeight="SemiBold" /><TextBlock Text="EnableTheSystemServiceForTheGlobalHotkey" Opacity="0.65" TextWrapping="Wrap" /></StackPanel><FontIcon Grid.Column="2" FontFamily="Segoe MDL2 Assets" Glyph="&#xE76C;" FontSize="16" VerticalAlignment="Center" /></Grid></Button>
            <Border Height="1" Margin="16,0" Background="{ThemeResource AppBorderBrush}" />
