        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <TextBlock Text="Pikslovo" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" />

      <Grid Grid.Row="1">
        <ScrollViewer x:Name="OnboardingLanguageStep" VerticalScrollBarVisibility="Hidden">
          <StackPanel Spacing="16" Padding="0,24,0,0">
            <StackPanel Spacing="8">
              <TextBlock Text="WelcomeToPikslovo" FontSize="28" FontWeight="SemiBold" />
              <TextBlock Text="PikslovoRecognizesTextOnYourGameScreenAndTranslatesItWithGoogleCloudTheScreenshotAndRecognizedTextAreSentToGoogleServicesOnlyWhileTranslating" Opacity="0.7" TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock Text="Languages" FontSize="15" FontWeight="SemiBold" Opacity="0.65" Margin="16,8,0,0" />
            <Border Style="{StaticResource SettingsGroupBorder}">
              <StackPanel>
                <Button Style="{StaticResource SettingsListItemButton}" Command="{Binding EditOnboardingSourceLanguageCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16,14">
                  <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE774;" FontSize="20" VerticalAlignment="Center" /><StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="SourceLanguage" FontWeight="SemiBold" /><TextBlock Text="{Binding OnboardingSourceLanguageLabel}" Opacity="0.65" /></StackPanel><FontIcon Grid.Column="2" FontFamily="Segoe MDL2 Assets" Glyph="&#xE76C;" FontSize="16" VerticalAlignment="Center" /></Grid>
                </Button>
                <Border Height="1" Margin="16,0" Background="{ThemeResource AppBorderBrush}" />
                <Button Style="{StaticResource SettingsListItemButton}" Command="{Binding EditOnboardingTargetLanguageCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16,14">
                  <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE774;" FontSize="20" VerticalAlignment="Center" /><StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="TargetLanguage" FontWeight="SemiBold" /><TextBlock Text="{Binding OnboardingTargetLanguageLabel}" Opacity="0.65" /></StackPanel><FontIcon Grid.Column="2" FontFamily="Segoe MDL2 Assets" Glyph="&#xE76C;" FontSize="16" VerticalAlignment="Center" /></Grid>
                </Button>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="OnboardingNotificationStep" Visibility="Collapsed" VerticalScrollBarVisibility="Hidden">
          <StackPanel Spacing="16" Padding="0,24,0,0">
            <StackPanel Spacing="8"><TextBlock Text="NotificationsSection" FontSize="28" FontWeight="SemiBold" /><TextBlock Text="DuringAnActiveSessionAndroidDisplaysAPersistentNotificationItIndicatesThatPikslovoCanCaptureTheScreenForTranslation" Opacity="0.7" TextWrapping="Wrap" /></StackPanel>
            <Border Style="{StaticResource SettingsGroupBorder}"><StackPanel>
              <Grid Margin="16,14" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE7ED;" FontSize="20" VerticalAlignment="Top" /><StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="VisibleActiveSession" FontWeight="SemiBold" /><TextBlock Text="TheNotificationRemainsVisibleWhileTheTranslatorRunsInTheBackground" Opacity="0.65" TextWrapping="Wrap" /></StackPanel></Grid>
              <Border Height="1" Margin="16,0" Background="{ThemeResource AppBorderBrush}" />
              <Grid Margin="16,14" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE73E;" FontSize="20" VerticalAlignment="Top" /><StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="SessionControl" FontWeight="SemiBold" /><TextBlock Text="YouCanStopTheActiveTranslatorSessionFromTheNotification" Opacity="0.65" TextWrapping="Wrap" /></StackPanel></Grid>
            </StackPanel></Border>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="OnboardingOverlayStep" Visibility="Collapsed" VerticalScrollBarVisibility="Hidden">
          <StackPanel Spacing="16" Padding="0,24,0,0">
            <StackPanel Spacing="8"><TextBlock Text="InGameOverlay" FontSize="28" FontWeight="SemiBold" /><TextBlock Text="PikslovoNeedsPermissionToDisplayOverOtherAppsSoItCanShowTheTranslatedImageWithoutLeavingTheGame" Opacity="0.7" TextWrapping="Wrap" /></StackPanel>
            <Border Style="{StaticResource SettingsGroupBorder}"><StackPanel>
              <Grid Margin="16,14" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE890;" FontSize="20" VerticalAlignment="Top" /><StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="TranslationOverTheGame" FontWeight="SemiBold" /><TextBlock Text="TheResultWillAppearAsATemporaryOverlayOverTheCurrentScreen" Opacity="0.65" TextWrapping="Wrap" /></StackPanel></Grid>
              <Border Height="1" Margin="16,0" Background="{ThemeResource AppBorderBrush}" />
              <Grid Margin="16,14" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8A1;" FontSize="20" VerticalAlignment="Top" /><StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="OnlyOnDemand" FontWeight="SemiBold" /><TextBlock Text="TheOverlayIsShownOnlyAfterTranslationIsTriggered" Opacity="0.65" TextWrapping="Wrap" /></StackPanel></Grid>
            </StackPanel></Border>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="OnboardingApiKeyStep" Visibility="Collapsed" VerticalScrollBarVisibility="Hidden">
          <StackPanel Spacing="16" Padding="0,24,0,0">
            <StackPanel Spacing="8"><TextBlock Text="GoogleCloudApi" FontSize="28" FontWeight="SemiBold" /><TextBlock Text="PikslovoRequiresYourOwnGoogleCloudApiKeyForTextRecognitionAndTranslationYouCanConfigureItNowOrLaterInSettingsTranslationWillNotWorkWithoutIt" Opacity="0.7" TextWrapping="Wrap" /></StackPanel>
            <Border Style="{StaticResource SettingsGroupBorder}"><StackPanel>
              <Grid Margin="16,14" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE72E;" FontSize="20" VerticalAlignment="Top" Margin="0,8,0,0" /><StackPanel Grid.Column="1" Spacing="8"><TextBlock Text="GoogleCloudApiKey" FontWeight="SemiBold" /><TextBlock Text="ImportantNeverShareThisKeyWithAnyone" Opacity="0.65" TextWrapping="Wrap" /><controls:ApiKeyInputControl x:Name="OnboardingApiKeyInput" PasswordChanged="OnboardingApiKeyInput_PasswordChanged" PasswordSubmitted="OnboardingApiKeyInput_PasswordSubmitted" PlaceholderText="AIza..." /></StackPanel></Grid>
              <Border Height="1" Margin="16,0" Background="{ThemeResource AppBorderBrush}" />
              <Button Style="{StaticResource SettingsListItemButton}" Command="{Binding OpenGoogleCloudApiKeyGuideCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16,14"><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE774;" FontSize="20" VerticalAlignment="Center" /><StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="GoogleCloudApiKeySetupGuide" FontWeight="SemiBold" /><TextBlock Text="OpenStepByStepInstructionsForCreatingAnApiKey" Opacity="0.65" TextWrapping="Wrap" /></StackPanel><FontIcon Grid.Column="2" FontFamily="Segoe MDL2 Assets" Glyph="&#xE8A7;" FontSize="16" VerticalAlignment="Center" /></Grid></Button>
            </StackPanel></Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <Border Grid.Row="2" Background="{ThemeResource AppBackgroundBrush}" BorderBrush="{ThemeResource AppBorderBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
        <Grid>
          <Grid x:Name="OnboardingLanguageFooter"><Button Style="{StaticResource ApiKeyTestButton}" Command="{Binding ContinueOnboardingLanguageCommand}">Continue</Button></Grid>
          <Grid x:Name="OnboardingNotificationFooter" Visibility="Collapsed"><Button x:Name="OnboardingNotificationPermissionButton" Style="{StaticResource ApiKeyTestButton}" Command="{Binding RequestOnboardingNotificationPermissionCommand}">GrantPermission</Button></Grid>
          <Grid x:Name="OnboardingOverlayFooter" Visibility="Collapsed"><Button Style="{StaticResource ApiKeyTestButton}" Command="{Binding RequestOnboardingOverlayPermissionCommand}">GrantPermission</Button></Grid>
          <Grid x:Name="OnboardingApiKeyFooter" Visibility="Collapsed" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Button x:Name="OnboardingApiKeyTestButton" Style="{StaticResource OnboardingSecondaryButton}" Command="{Binding TestOnboardingApiKeyCommand}">CheckKey</Button><Button x:Name="OnboardingContinueButton" Grid.Column="1" Style="{StaticResource ApiKeyTestButton}" Command="{Binding FinishOnboardingCommand}" IsEnabled="False">Continue</Button></Grid>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Page>
