                <Grid Margin="16,14" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE746;" FontSize="20" VerticalAlignment="Center" /><StackPanel Grid.Column="1" Spacing="8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="VerticalPosition" FontWeight="SemiBold" /><TextBlock Text="{Binding FloatingButtonVerticalPositionDisplay}" Grid.Column="1" Opacity="0.65" /></Grid><Slider Minimum="0" Maximum="1" StepFrequency="0.01" Value="{Binding FloatingButtonVerticalPosition, Mode=TwoWay}" /></StackPanel></Grid>
