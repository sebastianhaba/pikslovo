                <Grid Margin="16,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="OverlayRender" /><TextBlock Text="{Binding OverlayRenderDuration}" Grid.Column="1" FontWeight="SemiBold" /></Grid>
